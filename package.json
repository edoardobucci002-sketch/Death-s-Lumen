{
  "name": "death-s-lumen",
  "version": "0.1.0",
  "private": true,
  "description": "Death's Lumen: survivor-like in pixel art per iOS e Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build && node tools/genera-sw.mjs",
    "anteprima": "vite preview --host",
    "asset": "node tools/export-asset.mjs",
    "icone": "node tools/icone.mjs",
    "prova": "node tools/prova.mjs",
    "sim": "npm run build && node tools/sim.mjs",
    "app": "npm run build && cap sync",
    "ios": "npm run app && cap open ios",
    "android": "npm run app && cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/eb-garamond": "5.3.0",
    "@fontsource/im-fell-english": "5.3.0",
    "@fontsource/im-fell-english-sc": "5.3.0",
    "@fontsource/jersey-10": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "playwright": "1.56.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
